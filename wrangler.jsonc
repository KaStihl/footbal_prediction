{
  // Cloudflare Worker: password gate (src/worker.js) in front of the static ./site folder.
  // The name must match the Worker created in the Cloudflare dashboard.
  // The password is NOT stored here: set the secret SITE_PASSWORD in
  // Worker -> Settings -> Variables and Secrets (type: Secret).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "footbal-prediction",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
